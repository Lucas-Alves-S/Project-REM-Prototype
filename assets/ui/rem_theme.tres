[gd_resource type="Theme" format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Barlow-Medium.ttf" id="1_body"]
[ext_resource type="FontFile" path="res://assets/fonts/Barlow-Italic.ttf" id="2_body_italic"]
[ext_resource type="FontFile" path="res://assets/fonts/BarlowCondensed-BlackItalic.ttf" id="3_display"]
[ext_resource type="FontFile" path="res://assets/fonts/BarlowCondensed-ExtraBoldItalic.ttf" id="4_heading"]
[ext_resource type="FontFile" path="res://assets/fonts/BarlowCondensed-Bold.ttf" id="5_label"]

; Shear of 0.21 = tan(12deg). Applied on top of the italic files, like the
; mockup's `font-style: italic` + `skewX(-12deg)`.
[sub_resource type="FontVariation" id="FV_display"]
base_font = ExtResource("3_display")
spacing_glyph = -2
variation_transform = Transform2D(1, 0.21, 0, 1, 0, 0)

[sub_resource type="FontVariation" id="FV_heading"]
base_font = ExtResource("4_heading")
variation_transform = Transform2D(1, 0.21, 0, 1, 0, 0)

; Letter-spaced uppercase labels (tracking ~.2em).
[sub_resource type="FontVariation" id="FV_tag"]
base_font = ExtResource("5_label")
spacing_glyph = 4

[sub_resource type="FontVariation" id="FV_key"]
base_font = ExtResource("5_label")
spacing_glyph = 3
variation_transform = Transform2D(1, 0.21, 0, 1, 0, 0)

; ---------- Button (generic .rem-btn) ----------
[sub_resource type="StyleBoxFlat" id="Btn_normal"]
content_margin_left = 22.0
content_margin_top = 6.0
content_margin_right = 22.0
content_margin_bottom = 6.0
bg_color = Color(0.9608, 0.9529, 1, 0)
skew = Vector2(0.21, 0)
corner_radius_top_left = 12
corner_radius_bottom_right = 12
corner_detail = 1

[sub_resource type="StyleBoxFlat" id="Btn_selected"]
content_margin_left = 22.0
content_margin_top = 6.0
content_margin_right = 22.0
content_margin_bottom = 6.0
bg_color = Color(0.9608, 0.9529, 1, 1)
skew = Vector2(0.21, 0)
corner_radius_top_left = 12
corner_radius_bottom_right = 12
corner_detail = 1
shadow_color = Color(1, 0.1804, 0.5333, 1)
shadow_size = 1
shadow_offset = Vector2(8, 8)

; ---------- MenuItem (title / pause) ----------
; No shadow here: MenuItem.cs draws the two hard shadows as panels behind the
; button, because StyleBoxFlat only has one (and a blurry one at that).
[sub_resource type="StyleBoxFlat" id="Menu_normal"]
content_margin_left = 28.0
content_margin_top = 8.0
content_margin_right = 44.0
content_margin_bottom = 10.0
bg_color = Color(0.9608, 0.9529, 1, 0)
skew = Vector2(0.21, 0)

[sub_resource type="StyleBoxFlat" id="Menu_selected"]
content_margin_left = 28.0
content_margin_top = 8.0
content_margin_right = 44.0
content_margin_bottom = 10.0
bg_color = Color(0.9608, 0.9529, 1, 1)
skew = Vector2(0.21, 0)

[sub_resource type="StyleBoxFlat" id="Menu_shadow_trauma"]
bg_color = Color(1, 0.1804, 0.5333, 1)
skew = Vector2(0.21, 0)

[sub_resource type="StyleBoxFlat" id="Menu_shadow_magic"]
bg_color = Color(0.1804, 0.949, 0.8784, 1)
skew = Vector2(0.21, 0)

; ---------- TabButton (inventory tabs) ----------
[sub_resource type="StyleBoxFlat" id="Tab_selected"]
content_margin_left = 22.0
content_margin_top = 6.0
content_margin_right = 22.0
content_margin_bottom = 6.0
bg_color = Color(0.9608, 0.9529, 1, 1)
skew = Vector2(0.21, 0)
shadow_color = Color(1, 0.1804, 0.5333, 1)
shadow_size = 1
shadow_offset = Vector2(6, 6)

[sub_resource type="StyleBoxFlat" id="Tab_focus"]
draw_center = false
skew = Vector2(0.21, 0)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.1804, 0.949, 0.8784, 1)
expand_margin_left = 4.0
expand_margin_top = 4.0
expand_margin_right = 4.0
expand_margin_bottom = 4.0

; ---------- Slot (inventory, equipment, hotbar) ----------
[sub_resource type="StyleBoxFlat" id="Slot_normal"]
bg_color = Color(0.0549, 0.0784, 0.1882, 0.88)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6627, 0.6824, 0.7608, 0.22)
corner_radius_top_left = 12
corner_radius_bottom_right = 12
corner_detail = 1

[sub_resource type="StyleBoxFlat" id="Slot_hover"]
bg_color = Color(0.1098, 0.098, 0.2745, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6627, 0.6824, 0.7608, 0.22)
corner_radius_top_left = 12
corner_radius_bottom_right = 12
corner_detail = 1

; Drawn over normal/hover, under the icon and text, so it can repaint the fill.
[sub_resource type="StyleBoxFlat" id="Slot_selected"]
bg_color = Color(0.1373, 0.1137, 0.3216, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.9608, 0.9529, 1, 1)
corner_radius_top_left = 12
corner_radius_bottom_right = 12
corner_detail = 1

; ---------- Panels ----------
[sub_resource type="StyleBoxFlat" id="Tooltip_panel"]
content_margin_left = 24.0
content_margin_top = 24.0
content_margin_right = 24.0
content_margin_bottom = 24.0
bg_color = Color(0.0275, 0.0314, 0.0863, 0.9)
border_width_left = 4
border_color = Color(1, 0.1804, 0.5333, 1)
corner_radius_top_right = 24
corner_detail = 1

[sub_resource type="StyleBoxFlat" id="Equip_panel"]
bg_color = Color(0.0275, 0.0314, 0.0863, 0.55)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.9608, 0.9529, 1, 0.08)
corner_radius_bottom_left = 40
corner_detail = 1

[sub_resource type="StyleBoxFlat" id="Key_box"]
content_margin_left = 10.0
content_margin_top = 0.0
content_margin_right = 10.0
content_margin_bottom = 0.0
draw_center = false
skew = Vector2(0.21, 0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6627, 0.6824, 0.7608, 1)

[sub_resource type="StyleBoxLine" id="Divider"]
color = Color(0.9608, 0.9529, 1, 0.12)
thickness = 2

[sub_resource type="StyleBoxFlat" id="NameTag_panel"]
content_margin_left = 30.0
content_margin_top = 6.0
content_margin_right = 30.0
content_margin_bottom = 4.0
bg_color = Color(0.9608, 0.9529, 1, 1)
skew = Vector2(0.21, 0)
shadow_color = Color(1, 0.1804, 0.5333, 1)
shadow_size = 1
shadow_offset = Vector2(8, 8)

